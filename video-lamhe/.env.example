# Copy to .env at the repo root (shared by api + web): cp .env.example .env
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ---------- api ----------
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/video-lamhe   # local: npm run db:up · prod: MongoDB Atlas URI
MONGO_POOL_SIZE=20
JWT_ACCESS_SECRET=                                   # required, ≥ 32 chars
JWT_REFRESH_SECRET=                                  # required, ≥ 32 chars
WEB_URL=http://localhost:3000                        # comma-separated list of allowed origins; first one is used in emails
BCRYPT_ROUNDS=12
TRUST_PROXY=0                                        # proxies in front of the API: 0 local, usually 1 on Render/Nginx — REQUIRED in production
LOG_LEVEL=info

# Cloudinary — uploads (shorts, photos). Optional in dev (uploads return 503), REQUIRED in production.
# Dashboard → Settings → API Keys. Never paste these anywhere but .env.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (required in production — password reset; dev without SMTP logs emails to the console)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# WhatsApp
ADMIN_WHATSAPP=923462590643
WHATSAPP_ROUTING=admin                               # admin | operator

# Scale & monitoring (Phase 8)
REDIS_URL=                                           # empty in local dev → in-memory fallback
SENTRY_DSN=

# Google sign-in (optional; leave empty to hide the flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=                                 # e.g. https://api.videolamhe.pk/api/v1/auth/google/callback

# Tests (optional) — API tests use a throwaway DB on this server
TEST_MONGODB_URI=mongodb://127.0.0.1:27017

# Seed (Phase 2)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=                                 # ≥ 12 chars
SEED_OPERATOR_PASSWORD=                              # optional: shared login for the 6 sample operators (generated if empty)

# ---------- web ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
INTERNAL_API_URL=                                    # optional: API URL for Next.js server components (e.g. private network); defaults to NEXT_PUBLIC_API_URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_WHATSAPP=923462590643
